{
  "cleanUrls": true,
  "functions": {
    "api/data.js": {
      "maxDuration": 60
    },
    "api/prewarm.js": {
      "maxDuration": 60
    },
    "api/cron-notify.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/prewarm",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron-notify",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/embed/:code",
      "destination": "/:code"
    }
  ],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://oosayhi.com https://*.oosayhi.com"
        }
      ]
    },
    {
      "source": "/hub.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/hero.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/hero.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
