{
  "cleanUrls": true,
  "functions": {
    "api/data.js": {
      "maxDuration": 60
    },
    "api/cron-notify.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/embed/:code",
      "destination": "/:code"
    }
  ],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://oosayhi.com https://*.oosayhi.com"
        }
      ]
    }
  ]
}
